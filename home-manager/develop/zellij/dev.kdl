layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    // 上下两排、每排 4 个等宽窗格。手动拆出来的窗格边界容易错位,zellij 找不到
    // 贯通的边界就没法整体缩放(日志里是 `Ran out of room for spans`),窗口变大后
    // tab 会卡在旧宽度、右边留空,所以这里写死成对齐的网格。
    tab name="dev" {
        pane split_direction="vertical" {
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/console-new"
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/super-tradebot"
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/shared-runtime"
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/strategy"
        }
        pane split_direction="vertical" {
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/bobby-open-api"
            pane cwd="/home/xpj/Projects/FlowAI/rockbot"
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/mcp/rockflow/rockflow-mcp"
            pane cwd="/home/xpj/Projects/FlowAI/Mintopia/strategy"
        }
    }
    tab name="nixos" {
        pane cwd="/home/xpj/Projects/nixos-config"
        pane cwd="/home/xpj/Projects/nixos-config"
    }
tab name="k8s" {
    pane

    pane cwd="/home/xpj/.kube"
}
    // 跨窗口的活跃 Claude Code 会话面板,1s 检查一次(内容没变不重绘,所以不闪)。
    // cc-sessions 由 develop/claude-code.nix 提供;这里写 ~/.nix-profile 下的绝对路径是因为
    // zellij 的 command pane 不经过 shell,PATH 取决于 zellij 服务端是从哪里起的。
    tab name="cc" {
        pane command="/home/xpj/.nix-profile/bin/cc-sessions" {
            args "--watch" "1"
        }
    }
}
